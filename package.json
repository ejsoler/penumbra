{
  "name": "penumbra",
  "version": "0.1.0",
  "description": "A desktop app for Ollama, inspired by LM Studio",
  "author": "Emmanuel J. Soler Mendez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ejsoler/penumbra.git"
  },
  "homepage": "https://github.com/ejsoler/penumbra#readme",
  "bugs": {
    "url": "https://github.com/ejsoler/penumbra/issues"
  },
  "keywords": [
    "ollama",
    "llm",
    "electron",
    "react",
    "gui",
    "local-ai",
    "huggingface",
    "gguf"
  ],
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "node electron/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "icons": "node build/make-icons.mjs",
    "dist": "npm run build && electron-builder --mac dir",
    "install-app": "npm run dist && node build/install-app.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "productName": "Penumbra",
  "build": {
    "appId": "io.github.ejsoler.penumbra",
    "productName": "Penumbra",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "copyright": "Copyright © 2026 Emmanuel J. Soler Mendez"
  }
}
